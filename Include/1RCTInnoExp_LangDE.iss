[Messages]
// Setup Note in "About" dialog
german.AboutSetupNote=Erstellt mit Windose Installer Version {#RCInnoExpVer}.%nhttps://github.com/RainCandyTech/InnoSetupExperience

// Extra localization for Windose Installer
german.TranslatorNote=Deutsche Übersetzung gepflegt von Jens Brand (jens.brand@wolf-software.de).%n%nZusätzliche Übersetzungen für Windose Installer Korrektur%ngelesen von Germanium.

